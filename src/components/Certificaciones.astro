---
export interface Props {
  lang?: string;
}
const { lang = 'es' } = Astro.props;

const certificaciones = [
  {
    title: 'Model Context Protocol: Advanced Topics',
    date: lang === 'en' ? 'Sep 2026' : 'Sept. 2026',
  },
  {
    title: 'Introduction to Model Context Protocol',
    date: lang === 'en' ? 'Sep 2026' : 'Sept. 2026',
  },
  {
    title: 'Claude Code in Action',
    date: lang === 'en' ? 'Mar 2026' : 'Mar. 2026',
    verify: 'https://verify.skilljar.com/c/unuqrbfiaqya',
  },
];
---
<section id="certificaciones" class="max-w-2xl mx-auto py-12">
  <h2 class="text-2xl md:text-3xl font-bold text-center mb-10 text-gray-900 dark:text-gray-100">
    {lang === 'en' ? 'Certifications' : 'Certificaciones'}
  </h2>
  <div class="flex flex-col gap-4">
    {certificaciones.map((cert) => (
      <div class="relative flex items-center bg-gradient-to-r from-gray-100 via-orange-50 to-gray-200 dark:from-gray-800 dark:via-orange-900/20 dark:to-gray-900 rounded-xl shadow p-5 border-l-8 border-orange-300 dark:border-orange-700">
        <span class="flex-shrink-0 inline-flex items-center justify-center w-12 h-12 mr-5 rounded-full bg-white dark:bg-gray-800 shadow-md text-orange-600 dark:text-orange-300">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="9" r="6"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.5 13.8L7 22l5-3 5 3-1.5-8.2"/>
          </svg>
        </span>
        <div class="min-w-0">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-1">{cert.title}</h3>
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-sm text-gray-700 dark:text-gray-300 font-medium">Anthropic · Claude Academy</span>
            <span class="inline-block text-xs font-semibold px-3 py-1 rounded-full border border-orange-300 dark:border-orange-600 bg-white dark:bg-gray-900 text-orange-700 dark:text-orange-200 shadow-sm">{cert.date}</span>
            {cert.verify && (
              <a href={cert.verify} target="_blank" rel="noopener noreferrer"
                 class="group inline-flex items-center gap-1 text-xs font-semibold text-blue-700 dark:text-blue-300 hover:underline underline-offset-4">
                {lang === 'en' ? 'Verify' : 'Verificar'}
                <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </a>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
