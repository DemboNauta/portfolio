---
export interface Props {
  lang?: string;
}
const { lang = 'es' } = Astro.props;
---
<section id="tecnologias" class="max-w-4xl mx-auto py-12">
  <h2 class="text-2xl md:text-3xl font-bold text-center mb-8 text-gray-900 dark:text-gray-100">
    {lang === 'en' ? 'Technologies' : 'Tecnologías'}
  </h2>
  
  <div class="flex flex-wrap justify-center gap-3 mb-8">
    <!-- IA Generativa -->
    <div class="group">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-emerald-100 dark:bg-emerald-900/30 text-emerald-800 dark:text-emerald-200 rounded-full text-sm font-medium border border-emerald-200 dark:border-emerald-800 transition-all duration-300 ease-in-out hover:bg-emerald-200 dark:hover:bg-emerald-800/40 hover:scale-105">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2l1.9 5.1L19 9l-5.1 1.9L12 16l-1.9-5.1L5 9l5.1-1.9L12 2zm6.5 12l.95 2.55L22 17.5l-2.55.95L18.5 21l-.95-2.55L15 17.5l2.55-.95L18.5 14zM5.5 13l.76 2.04L8.3 15.8l-2.04.76L5.5 18.6l-.76-2.04L2.7 15.8l2.04-.76L5.5 13z"/>
        </svg>
        {lang === 'en' ? 'Generative AI' : 'IA Generativa'}
      </div>
    </div>

    <!-- MCP -->
    <div class="group">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-teal-100 dark:bg-teal-900/30 text-teal-800 dark:text-teal-200 rounded-full text-sm font-medium border border-teal-200 dark:border-teal-800 transition-all duration-300 ease-in-out hover:bg-teal-200 dark:hover:bg-teal-800/40 hover:scale-105">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="12" cy="18" r="2.5"/>
          <path stroke-linecap="round" d="M6 8.5v3a2 2 0 002 2h1.6M18 8.5v3a2 2 0 01-2 2h-1.6M12 13.5v2"/>
        </svg>
        MCP
      </div>
    </div>

    <!-- Angular -->
    <div class="group">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-200 rounded-full text-sm font-medium border border-red-200 dark:border-red-800 transition-all duration-300 ease-in-out hover:bg-red-200 dark:hover:bg-red-800/40 hover:scale-105">
        <img src="/icons/angular.svg" height="20" width="20"/>
        Angular
      </div>
    </div>

    <!-- C#/.NET -->
    <div class="group">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-purple-100 dark:bg-purple-900/30 text-purple-800 dark:text-purple-200 rounded-full text-sm font-medium border border-purple-200 dark:border-purple-800 transition-all duration-300 ease-in-out hover:bg-purple-200 dark:hover:bg-purple-800/40 hover:scale-105">
        <img src="/icons/dotnetcore.svg" height="20" width="20"/>
        C#/.NET
      </div>
    </div>

    <!-- JavaScript -->
    <div class="group">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-200 rounded-full text-sm font-medium border border-yellow-200 dark:border-yellow-800 transition-all duration-300 ease-in-out hover:bg-yellow-200 dark:hover:bg-yellow-800/40 hover:scale-105">
        <img src="/icons/javascript.svg" height="20" width="20"/>
        JavaScript
      </div>
    </div>

    <!-- Python -->
    <div class="group">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-200 rounded-full text-sm font-medium border border-blue-200 dark:border-blue-800 transition-all duration-300 ease-in-out hover:bg-blue-200 dark:hover:bg-blue-800/40 hover:scale-105">
        <img src="/icons/python.svg" height="20" width="20"/>
        Python
      </div>
    </div>

    <!-- PHP -->
    <div class="group">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-indigo-100 dark:bg-indigo-900/30 text-indigo-800 dark:text-indigo-200 rounded-full text-sm font-medium border border-indigo-200 dark:border-indigo-800 transition-all duration-300 ease-in-out hover:bg-indigo-200 dark:hover:bg-indigo-800/40 hover:scale-105">
        <img src="/icons/php.svg" height="20" width="20"/>
        PHP
      </div>
    </div>
  </div>

  <div class="text-center">
    <p class="text-gray-600 dark:text-gray-400 text-sm max-w-2xl mx-auto leading-relaxed">
      {lang === 'en' 
        ? 'These are the main technologies I work with and have experience in, from Angular and .NET to Generative AI: LLM integration, image generation, chatbots, document analysis and MCP (Model Context Protocol) server development.'
        : 'Estas son las principales tecnologías con las que trabajo y tengo experiencia, desde Angular y .NET hasta la IA Generativa: integración de LLMs, generación de imágenes, chatbots, análisis de documentos y desarrollo de servidores MCP (Model Context Protocol).'}
    </p>
  </div>
</section> 