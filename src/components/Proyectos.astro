---
export interface Props {
  lang?: string;
}
const { lang = 'es' } = Astro.props;
const en = lang === 'en';

interface Proyecto {
  name: string;
  subtitle?: string;
  image?: string;
  imageClass?: string;
  tags: string[];
  text: string;
  code: string;
  live?: string;
  via: string;
}

const proyectos: Proyecto[] = [
  {
    name: 'garmin-ia',
    subtitle: 'Garmin Bridge',
    image: '/img/garminBridge.webp',
    imageClass: 'object-top',
    tags: ['Python', 'FastAPI', 'MCP', 'OAuth 2.1 + PKCE'],
    text: en
      ? "Remote, multi-user MCP server that connects Garmin Connect to Claude and ChatGPT. The assistant reads sleep, HRV and recovery data and writes structured workouts back to the user's Garmin account. Includes OAuth 2.1 + PKCE, encrypted tokens and a web dashboard. Live in production."
      : 'Servidor MCP remoto y multiusuario que conecta Garmin Connect con Claude y ChatGPT. El asistente lee los datos de sueño, HRV y recuperación, y escribe entrenamientos estructurados en la cuenta de Garmin del usuario. Incluye OAuth 2.1 + PKCE, tokens cifrados y un panel web. En producción.',
    code: 'https://github.com/DemboNauta/garmin-ia',
    live: 'https://garmin.cryptoaiarena.com',
    via: 'via-blue-50/30 dark:via-blue-900/20',
  },
  {
    name: 'skill-doc-generator',
    tags: ['MCP', 'Claude Code', 'Skills', 'npm'],
    text: en
      ? 'MCP server, published on npm, that turns any documentation URL into a ready-to-use Claude Code Skill. It bundles the skill-creator workflow with grader and comparator subagents to evaluate and iterate on Skills. No API key required: the agent does the reasoning and the server handles fetching and saving.'
      : 'Servidor MCP, publicado en npm, que convierte cualquier URL de documentación en una Skill de Claude Code lista para usar. Incluye el flujo de skill-creator con subagentes que califican y comparan resultados para evaluar las Skills e iterar sobre ellas. No necesita API key: el agente razona y el servidor se encarga de descargar y guardar.',
    code: 'https://github.com/DemboNauta/skill-doc-generator',
    via: 'via-orange-50/30 dark:via-orange-900/20',
  },
  {
    name: 'self-hosted-claude-pdf-assistant',
    tags: ['TypeScript', 'Claude Agent SDK'],
    text: en
      ? 'Self-hosted, multi-user study assistant built on the Claude Agent SDK. Claude reads your PDFs, answers with page citations, points at the page, highlights passages, explains on a hand-drawn whiteboard, builds summaries and quizzes, and writes spaced-repetition flashcards based on what you struggle with. It also has a voice mode that explains out loud. Runs on your own Claude subscription, no API key.'
      : 'Asistente de estudio self-hosted y multiusuario construido sobre el Claude Agent SDK. Claude lee tus PDFs, responde citando la página, señala en ella, resalta pasajes, explica en una pizarra dibujada a mano, prepara resúmenes y tests, y crea flashcards con repetición espaciada según lo que más te cuesta. También tiene un modo de voz que lo explica en alto. Funciona con tu propia suscripción de Claude, sin API key.',
    code: 'https://github.com/DemboNauta/self-hosted-claude-pdf-assistant',
    via: 'via-purple-50/30 dark:via-purple-900/20',
  },
  {
    name: 'ai-investor',
    subtitle: 'CryptoAiArena',
    image: '/img/cryptoAiArena.webp',
    imageClass: 'object-top',
    tags: ['Python', en ? 'LLM agents' : 'Agentes LLM', 'OpenAI', 'xAI'],
    text: en
      ? 'Six autonomous LLM agents split into two teams that trade crypto (paper trading, no real money) under identical strategies, to compare which model makes better decisions. Each agent has its own portfolio and persistent memory, and results are published on a public live dashboard.'
      : 'Seis agentes LLM autónomos, divididos en dos equipos, que operan con criptomonedas (paper trading, sin dinero real) siguiendo estrategias idénticas para comparar qué modelo toma mejores decisiones. Cada agente tiene su propia cartera y memoria persistente, y los resultados se publican en un dashboard público en directo.',
    code: 'https://github.com/DemboNauta/ai-investor',
    live: 'https://cryptoaiarena.com',
    via: 'via-green-50/30 dark:via-green-900/20',
  },
  {
    name: 'polymarket-mcp',
    tags: ['PHP', 'Laravel', 'MCP'],
    text: en
      ? 'MCP server exposing live Polymarket prediction market data to LLMs: prices, order books, arbitrage edges and momentum signals.'
      : 'Servidor MCP que da a los LLMs datos en directo de los mercados de predicción de Polymarket: precios, libros de órdenes, oportunidades de arbitraje y señales de momentum.',
    code: 'https://github.com/DemboNauta/polymarket-mcp',
    via: 'via-teal-50/30 dark:via-teal-900/20',
  },
];

const anteriores = [
  {
    name: 'DevThreads',
    text: en
      ? 'My DAW final project: a social network for programmers (Angular 17, Bootstrap 5 and a PHP API).'
      : 'Mi TFG de DAW: una red social para programadores (Angular 17, Bootstrap 5 y una API en PHP).',
    code: 'https://github.com/DemboNauta/devthreads',
  },
  {
    name: 'Statistics Enjoyer',
    text: en
      ? 'Statistics from survey CSV files, with PHP, MySQL and Chart.js.'
      : 'Estadísticas a partir de encuestas en CSV, con PHP, MySQL y Chart.js.',
    code: 'https://github.com/DemboNauta/statisticsEnjoyer',
  },
  {
    name: 'EdgarCountryMadness',
    text: en
      ? 'Country and city information from public APIs, plus a guess-the-flag mini-game.'
      : 'Información de países y ciudades desde APIs públicas, con un minijuego de adivinar la bandera.',
    code: 'https://github.com/DemboNauta/edgarCountryMadness',
    live: 'https://edgarcountrymadness.netlify.app/',
  },
];

const githubPath = 'M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z';
---
<section id="proyectos" class="max-w-4xl mx-auto py-12">
  <h2 class="text-2xl md:text-3xl font-bold text-center mb-10 text-gray-900 dark:text-gray-100">
    {en ? 'Projects' : 'Proyectos'}
  </h2>
  <div class="space-y-12">
    {proyectos.map((p) => (
      <article class={`bg-gradient-to-r from-gray-50 ${p.via} to-gray-100 dark:from-gray-800 dark:to-gray-900 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 ease-in-out overflow-hidden`}>
        <div class="flex flex-col md:flex-row">
          <div class="md:w-1/2 p-6">
            {p.image ? (
              <a href={p.live ?? p.code} target="_blank" rel="noopener noreferrer" class="group block">
                <img src={p.image} alt={`${p.subtitle ?? p.name} ${en ? 'screenshot' : 'captura'}`} loading="lazy"
                     class={`w-full h-64 object-cover ${p.imageClass ?? ''} rounded-xl shadow-md transition-all duration-300 ease-in-out group-hover:scale-105 group-hover:shadow-xl`} />
              </a>
            ) : (
              <!-- Marcador de posición: el repositorio aún no tiene captura -->
              <div class="w-full h-64 rounded-xl shadow-md flex flex-col items-center justify-center gap-3 bg-gradient-to-br from-gray-800 via-gray-900 to-black text-gray-100 border border-gray-700">
                <svg class="w-10 h-10 text-emerald-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l-3 3 3 3M16 9l3 3-3 3M13.5 6l-3 12"/>
                </svg>
                <span class="font-mono text-sm md:text-base px-4 text-center break-all">{p.name}</span>
              </div>
            )}
          </div>
          <div class="md:w-1/2 p-6 flex flex-col justify-center">
            <h3 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-1 break-words">{p.name}</h3>
            {p.subtitle && <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-3">{p.subtitle}</p>}
            <div class={`flex flex-wrap gap-2 mb-4 ${p.subtitle ? '' : 'mt-3'}`}>
              {p.tags.map((tag) => (
                <span class="px-2 py-1 bg-gray-200 dark:bg-gray-800 text-gray-800 dark:text-gray-200 rounded text-xs">{tag}</span>
              ))}
            </div>
            <p class="text-gray-700 dark:text-gray-300 mb-6 leading-relaxed">{p.text}</p>
            <div class="flex flex-wrap gap-3">
              <a href={p.code} target="_blank" rel="noopener noreferrer"
                 class="group inline-flex items-center gap-2 px-4 py-2 bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 rounded-full text-sm font-medium hover:bg-gray-800 dark:hover:bg-gray-200 transition-all duration-300 ease-in-out hover:shadow-lg hover:shadow-gray-900/25 dark:hover:shadow-gray-100/25">
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:rotate-12" fill="currentColor" viewBox="0 0 24 24">
                  <path d={githubPath}/>
                </svg>
                {en ? 'Code' : 'Código'}
              </a>
              {p.live && (
                <a href={p.live} target="_blank" rel="noopener noreferrer"
                   class="group inline-flex items-center gap-2 px-4 py-2 bg-white dark:bg-black text-black dark:text-white rounded-full text-sm font-medium border border-gray-300 dark:border-white transition-all duration-300 ease-in-out hover:shadow-lg hover:shadow-gray-400/25 dark:hover:shadow-white/25 hover:bg-gray-50 dark:hover:bg-gray-900">
                  <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                  {en ? 'Live' : 'En vivo'}
                </a>
              )}
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>

  <!-- Proyectos anteriores -->
  <h3 class="text-lg md:text-xl font-semibold text-center mt-16 mb-6 text-gray-700 dark:text-gray-300">
    {en ? 'Earlier projects' : 'Proyectos anteriores'}
  </h3>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    {anteriores.map((p) => (
      <div class="flex flex-col bg-gray-50 dark:bg-gray-800/60 rounded-xl shadow p-4 border border-gray-200 dark:border-gray-700">
        <h4 class="font-semibold text-gray-900 dark:text-gray-100 mb-1">{p.name}</h4>
        <p class="text-sm text-gray-600 dark:text-gray-400 mb-3 flex-1">{p.text}</p>
        <div class="flex gap-4 text-sm font-medium">
          <a href={p.code} target="_blank" rel="noopener noreferrer" class="text-gray-800 dark:text-gray-200 hover:underline underline-offset-4">{en ? 'Code' : 'Código'}</a>
          {p.live && (
            <a href={p.live} target="_blank" rel="noopener noreferrer" class="text-gray-800 dark:text-gray-200 hover:underline underline-offset-4">Preview</a>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
